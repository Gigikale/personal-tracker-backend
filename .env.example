DATABASE_URL="postgresql://user:password@localhost:5433/personal_tracker?schema=public"
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
# Comma-separated allowed origins for the frontend (e.g. https://your-app.vercel.app). Leave unset to allow any origin.
CORS_ORIGIN=

# Optional: error tracking (https://sentry.io) — leave unset to disable.
SENTRY_DSN=

# Optional: password-reset emails via Resend (https://resend.com) — leave unset to disable that feature.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL="Personal Tracker <onboarding@resend.dev>"
# Public frontend URL, used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:5173

# Optional: Google sign-in (https://console.cloud.google.com) — leave both unset to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of this backend, used as the OAuth redirect target.
BACKEND_URL=http://localhost:4000
